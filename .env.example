# Example only: never use a public/example token.
# bash install.sh creates .env with a random token and mode 600.
# Read/edit the real token locally; never commit or paste it into logs.
PANEL_TOKEN=
HOST=127.0.0.1
PORT=8080
PANEL_DATA=./data
PANEL_PACE=5.0
# HTTP transport bytes, not model context; lower values allowed, hard ceiling 1 MiB.
PANEL_MAX_REQUEST_BYTES=1048576
